# Python bytecode caches (local runs make them; scoring deletes them from submission/ before the build)
__pycache__/
*.pyc

# Vendored / downloaded binaries (re-fetchable; see README for versions)
*.tar.bz2
debs/
sysroot/

# Game install: your own Dwarf Fortress download; only the config the challenge ships is tracked
df/*
!df/prefs/
df/prefs/*
!df/prefs/init.txt
!df/prefs/d_init.txt
!df/prefs/portable.txt
!df/prefs/world_gen.txt
!df/dfhack-config/
df/dfhack-config/*
!df/dfhack-config/remote-server.json

# Run outputs and logs
p2/
*.log

# Parallel DF instances (created on demand from df/ by instance.sh)
instances/
.batch.lock

# Forts and snapshots are built from seeds (docker/embark.sh, embark/make_task_fort.sh, pool/dfpool), never committed
scenarios/snapshots/embark-*
scenarios/snapshots/fort-*
scenarios/snapshots/my1-*

# runner/yukon/run.sh output
.yukon/runs/
